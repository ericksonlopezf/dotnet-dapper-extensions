<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <AssemblyName>EricksonLopez.DapperExtensions</AssemblyName>
    <RootNamespace>EricksonLopez.DapperExtensions</RootNamespace>
    <PackageId>EricksonLopez.DapperExtensions</PackageId>
    <Description>High-performance, provider-agnostic Dapper extensions. Provides Unit of Work and Savepoints, fluent MultiMapBuilder supporting 8+ entities, and resilience pipeline integration via EricksonLopez.Resilience.Abstractions. Polly v8 pipelines (ResiliencePipeline) are supported via the IResiliencePipeline adapter.</Description>
    <PackageTags>$(CommonPackageTags);unit-of-work;savepoints;multimap;mapping;resilience;type-handlers</PackageTags>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Dapper" />
    <PackageReference Include="Microsoft.Extensions.Resilience" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="EricksonLopez.Resilience.Abstractions" />
    <PackageReference Include="EricksonLopez.Resilience.Polly" />
    <PackageReference Include="EricksonLopez.SqlBuilder.Abstractions" />
    <PackageReference Include="EricksonLopez.Pagination.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="EricksonLopez.DapperExtensions.Tests" />
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
  </ItemGroup>

</Project>
