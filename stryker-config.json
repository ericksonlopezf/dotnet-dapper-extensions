{
  "stryker-config": {
    "project": "EricksonLopez.DapperExtensions.csproj",
    "test-projects": [
      "tests/EricksonLopez.DapperExtensions.Tests/EricksonLopez.DapperExtensions.Tests.csproj",
      "tests/EricksonLopez.DapperExtensions.Tests.Resilience/EricksonLopez.DapperExtensions.Tests.Resilience.csproj",
      "tests/EricksonLopez.DapperExtensions.Tests.UnitOfWork/EricksonLopez.DapperExtensions.Tests.UnitOfWork.csproj"
    ],
    "test-case-filter": "Category!=Integration",
    "mutate": [
      "**/*.cs",
      "!bin/**",
      "!obj/**",
      "!**/*.g.cs",
      "!**/*.AssemblyInfo.cs"
    ],
    "thresholds": {
      "high": 100,
      "low": 98,
      "break": 95
    },
    "reporters": [
      "html",
      "json",
      "cleartext",
      "progress"
    ],
    "ignore-methods": [
      "ConfigureAwait",
      "*ConfigureAwait"
    ],
    "concurrency": 2
  }
}
