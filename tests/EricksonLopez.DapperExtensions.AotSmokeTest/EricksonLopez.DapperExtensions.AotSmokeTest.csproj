<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks></TargetFrameworks>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>EricksonLopez.DapperExtensions.AotSmokeTest</RootNamespace>
    <AssemblyName>EricksonLopez.DapperExtensions.AotSmokeTest</AssemblyName>
    <Nullable>enable</Nullable>
    <PublishAot>true</PublishAot>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <IsPackable>false</IsPackable>
    <IsTestProject>false</IsTestProject>
    <SonarQubeExclude>true</SonarQubeExclude>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\EricksonLopez.DapperExtensions\EricksonLopez.DapperExtensions.csproj" />
    <ProjectReference Include="..\..\src\EricksonLopez.DapperExtensions.Sqlite\EricksonLopez.DapperExtensions.Sqlite.csproj" />
  </ItemGroup>

</Project>
